{
  "name": "senqo-whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "First-party WhatsApp session manager built directly on Baileys. Replaces Evolution API.",
  "scripts": {
    "dev": "node ./node_modules/.bin/tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "baileys": "^7.0.0-rc14",
    "hono": "^4.7.10",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
