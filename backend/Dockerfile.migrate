FROM node:22-alpine
WORKDIR /app/backend
# Build tools for isolated-vm: its postinstall downloads a prebuilt binary, but
# falls back to node-gyp compilation (which needs python3 + a C++ toolchain) when
# the download fails — same as the backend image.
RUN apk add --no-cache python3 make g++
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci
COPY backend/drizzle.config.ts ./
COPY backend/tsconfig.json ./
COPY backend/src ./src
COPY database/migrations ../database/migrations
CMD ["sh", "-c", "npx drizzle-kit migrate --config=drizzle.config.ts && npx tsx src/scripts/seed-all-workspace-custom-tools.ts"]
